  "evaluation_profiles": {
    "representative_v0": {
      "status": "provisional_product_prior",
      "description": "Agent-specific weighting for product impact. Atomic and clarification traffic are anchored to sanitized 8790/8793 action/phase logs; sequential versus conditional shares cannot be recovered because raw user text is intentionally not retained, so their 8%/2% split is a provisional product prior rather than an observed language frequency.",
      "group_weights": {
        "atomic": 0.70,
        "clarify_or_unsupported": 0.20,
        "sequential": 0.08,
        "conditional": 0.02
      },
      "hard_gates": [
        "current_atomic_false_admissions",
        "observable_differences",
        "diagnostic_effective_forbidden",
        "current_conditional_tool_turns"
      ]
    }
  },
